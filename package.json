{
  "name": "web-collage",
  "version": "2.0.0",
  "private": true,
  "description": "아무 웹사이트에서나 보이는 그대로의 조각을 끌어 크롬 사이드 패널의 콜라주에 모으는 익스텐션",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/check-no-testhooks.mjs .output/chrome-mv3",
    "build:e2e": "cross-env WXT_E2E=1 wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "pnpm build:e2e && python e2e/run_all.py",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
